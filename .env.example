# Copy this file to .env and fill in real values. Never commit .env.
# Easiest: .\scripts\init-env.ps1 (or scripts/init-env.sh) fills every value.

# ---- Postgres (used by the postgres container) ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---- GoTrue (login), MT.1 ----
# password of GoTrue's own database login (its `auth` database, same server)
GOTRUE_DB_PASSWORD=
# GoTrue signs its tokens with it; the control plane verifies them with it.
# At least 32 random characters.
GOTRUE_JWT_SECRET=
# a JWT with role "service_role", signed with GOTRUE_JWT_SECRET: opens GoTrue's
# admin API (create, invite and ban users). A secret.
GOTRUE_SERVICE_ROLE_KEY=

# ---- Control plane ----
# Four database logins (MT.3, MT.5), e.g. postgresql+asyncpg://<user>:<password>@postgres:5432/<db>
# The schema owner (POSTGRES_USER), passed only to the database setup job.
MIGRATION_DATABASE_URL=
# The API's own login, always `apim_app`: no UPDATE or DELETE on audit events.
DATABASE_URL=
# The audit retention login, shared by the retention and database setup jobs.
AUDIT_RETENTION_DATABASE_URL=
# The workspace purge login (MT.5), shared by the purge and database setup jobs.
PURGE_DATABASE_URL=
# Audit events older than this are deleted by the retention job (default 365).
AUDIT_RETENTION_DAYS=365
# Workspace defaults (MT.5), for every workspace without its own value; the
# Platform Admin sets one per workspace (PATCH /api/v1/workspaces/{slug}/limits).
WORKSPACE_RATE_LIMIT_PER_MIN=6000
WORKSPACE_MAX_CONCURRENT=200
WORKSPACE_MAX_SERVICES=100
WORKSPACE_MAX_ROUTES=500
WORKSPACE_MAX_CONSUMERS=5000
# A deleted workspace can be restored this many days, then it is purged.
PURGE_AFTER_DAYS=30
# Request bodies (MT.11): the limit of a route without its own, and the most a
# route may set. Bytes, or a size: 10MiB (binary) or 10MB (decimal).
MAX_REQUEST_BODY=10MiB
MAX_REQUEST_BODY_CEILING=100MiB
# Internal hosts and networks tenants' services may reach anyway (MT.9, SSRF
# protection), comma-separated: host names, addresses, networks such as
# 10.20.0.0/16. Read by the gateway and the control plane. Everything else
# internal (private, loopback, link-local, Docker's networks) is refused.
# Locally the two mock backends; in production leave it empty unless you need one.
UPSTREAM_ALLOW=mock-backend,mock-backend-2
# shared secret between control plane and gateway
INTERNAL_TOKEN=
GOTRUE_URL=http://auth:9999
# The first Platform Admin, created in GoTrue at startup if missing. With a
# password (12+ characters) it can log in at once; without one GoTrue sends an
# invitation email (Mailpit, http://localhost:8025) to choose a password.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ---- Gateway ----
CONTROL_PLANE_URL=http://control-plane:8000
REDIS_URL=redis://redis:6379/0
# how long the control plane may hold a long-poll config request
CONFIG_WAIT=30s
# workspaces are its subdomains: acme.<this> reaches workspace `acme` (MT.7);
# localhost needs no DNS (acme.localhost); e.g. gw.example.com in production
GATEWAY_BASE_DOMAIN=localhost
# LISTEN_ADDR (":8080") is set in docker-compose.yml, next to the port
# mapping that depends on it. SHUTDOWN_TIMEOUT defaults to 5s.
