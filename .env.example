# Copy this file to .env and fill in real values. Never commit .env.

# ---- Postgres (used by the postgres container) ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---- Control plane ----
# e.g. postgresql+asyncpg://<user>:<password>@postgres:5432/<db>
DATABASE_URL=
# random 32 bytes, e.g. py -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# optional, minutes an access token stays valid (default 60)
# JWT_EXPIRE_MINUTES=60
# shared secret between control plane and gateway
INTERNAL_TOKEN=
# seeds the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Gateway ----
CONTROL_PLANE_URL=http://control-plane:8000
REDIS_URL=redis://redis:6379/0
# how long the control plane may hold a long-poll config request
CONFIG_WAIT=30s
LISTEN_ADDR=:8080
